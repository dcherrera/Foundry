# Foundry Blackhole backend — the puller's AWAIT step off hardware.
#
#   make -f Makefile.pullerawait run    build and run; no card
#   make -f Makefile.pullerawait red    the first mismatch refuses (no retry): MUST fail
#
# NO CARD. It runs the KERNEL'S OWN AWAIT step (kernels/resident_puller_abi.h, the inline
# resident_puller.c compiles) against an emulated resident writer and the host queue's token
# arithmetic (ft_tt_queue.c). Both targets rebuild from scratch: Apple's GNU make 3.81 has
# one-second mtimes, and a red loop on incremental make can run the previous binary
# (coding-best-practices.md rule 8).

CC      ?= cc
SRC_DIR := ..
BUILD   := build-pullerawait

CFLAGS  := -std=c11 -O1 -g \
           -Wall -Wextra -Werror -pedantic \
           -Wshadow -Wconversion -Wstrict-prototypes -Wformat=2 \
           -fstack-protector-strong \
           -I$(SRC_DIR)

SOURCES := $(SRC_DIR)/ft_tt_kmd.c \
           $(SRC_DIR)/ft_tt_arch.c \
           $(SRC_DIR)/ft_tt_arch_blackhole.c \
           $(SRC_DIR)/ft_tt_device.c \
           $(SRC_DIR)/ft_tt_tlb.c \
           $(SRC_DIR)/ft_tt_coord.c \
           $(SRC_DIR)/ft_tt_noc.c \
           $(SRC_DIR)/ft_tt_buffer.c \
           $(SRC_DIR)/ft_tt_elf.c \
           $(SRC_DIR)/ft_tt_kernel_blob.c \
           $(SRC_DIR)/ft_tt_launch.c \
           $(SRC_DIR)/ft_tt_queue.c \
           $(SRC_DIR)/ft_tt_group.c \
           $(SRC_DIR)/ft_tt_watchdog.c \
           ft_tt_test_report.c \
           test_puller_await.c

.PHONY: run red clean

run:
	rm -rf $(BUILD) && mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(SOURCES) -o $(BUILD)/test_puller_await
	./$(BUILD)/test_puller_await

red:
	rm -rf $(BUILD) && mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -DFT_TT_PULLER_AWAIT_HOST_RED_NO_RETRY $(SOURCES) -o $(BUILD)/test_puller_await_red
	! ./$(BUILD)/test_puller_await_red

clean:
	rm -rf $(BUILD)
