# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 David (Corey) Herrera
# Foundry Blackhole backend — qwen36 plan Phase 5.3: the MoE router program (router matmul at fp32
# output + the routing step in its writer, rtriad_router).
#
#   make -f Makefile.q36moe PHASE1B=1 all
#
# ON CARD ONLY (PHASE1B=1 is mandatory). Run it through run_q36_phase5_router.sh, which
# builds the program directory it drives and probes the core before and after.

CC      ?= cc
SRC_DIR := ..

include hardware_session_sources.mk
CONVERT := ../convert
BUILD   := build-q36router

CFLAGS  := -std=c99 -O1 -g \
           -Wall -Wextra -Werror -Wno-attributes -pedantic \
           -Wshadow -Wconversion -Wstrict-prototypes -Wformat=2 \
           -fstack-protector-strong \
           -I$(SRC_DIR)
LDLIBS  := -lm

ifdef PHASE1B
CFLAGS += -DFT_TT_PHASE1B_NOC_ENABLED
endif

BACKEND := $(SRC_DIR)/ft_tt_kmd.c \
           $(SRC_DIR)/ft_tt_arch.c \
           $(SRC_DIR)/ft_tt_arch_blackhole.c \
           $(SRC_DIR)/ft_tt_device.c \
           $(SRC_DIR)/ft_tt_tlb.c \
           $(SRC_DIR)/ft_tt_arc_telemetry.c \
           $(SRC_DIR)/ft_tt_coord.c \
           $(SRC_DIR)/ft_tt_noc.c \
           $(SRC_DIR)/ft_tt_buffer.c \
           $(SRC_DIR)/ft_tt_elf.c \
           $(SRC_DIR)/ft_tt_kernel_blob.c \
           $(SRC_DIR)/ft_tt_tensix_claim.c \
           $(SRC_DIR)/ft_tt_launch.c \
           $(SRC_DIR)/ft_tt_tilize.c \
           $(SRC_DIR)/ft_tt_op_dispatch.c \
           $(SRC_DIR)/ft_tt_queue.c \
           $(SRC_DIR)/ft_tt_group.c \
           $(SRC_DIR)/ft_tt_watchdog.c

CONVERT_SRC := $(CONVERT)/ft_gguf_map.c $(CONVERT)/ft_gguf_dequant.c $(CONVERT)/ft_float_convert.c
SUPPORT := ft_tt_test_report.c $(HARDWARE_SESSION_SOURCES) ft_tt_program_directory.c

.PHONY: all red clean

all: $(BUILD)/test_q36_router

$(BUILD):
	mkdir -p $(BUILD)

# Whole-program link; `red` rebuilds from scratch (GNU make 3.81's one-second mtime trap).
$(BUILD)/test_q36_router: test_q36_router.c ../kernels/resident_matmul_moe_protocol.h ../kernels/ft_moe_route.h $(BACKEND) $(CONVERT_SRC) $(SUPPORT) | $(BUILD)
	$(CC) $(CFLAGS) -o $@ $< $(sort $(BACKEND) $(CONVERT_SRC) $(SUPPORT)) $(LDLIBS)

red: clean all

clean:
	rm -rf $(BUILD)
