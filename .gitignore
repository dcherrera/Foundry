# Metal test/bench binaries — tracking these means make will not rebuild
# them after a checkout, so a stale binary silently benchmarks old code.
metal/tests/bench_attn_split
metal/tests/bench_matvec_bandwidth
metal/tests/test_metal
metal/tests/test_metal_*
metal/tests/test_matvec_*
!metal/tests/*.c
!metal/tests/*.h
!metal/tests/*.m
!metal/tests/*.md
# Hand-recorded bench results (bench_dispatch.m / bench_matvec_bandwidth.m): local only.
metal/tests/RESULTS_*.md

# Tenstorrent backend test build dirs (build-coord, build-attn, ...)
tt/tests/build*/
tt/convert/tests/build*/

# Tenstorrent kernel program directories (matmul, matmul_bfp8, matmul_bfp4, ...) —
# built by build_tensix_program.sh from tt/kernels/, one per op. Mixed .o/.elf/.h/.cpp/.ld
# output that the generic *.o rule above only partly covers; a `git add -A`
# already swept these into commits once.
tt/programs/


# K80 strap kernel: build outputs and the build-time kernel config (third-party; never committed).
barswap/k80_quirk/prebuilt/
barswap/k80_quirk/out/
barswap/k80_quirk/target.config

# RWKV World vocab (BlinkDL, Apache-2.0): fetched at build time by rwkvx/data/fetch_rwkv_vocab.sh.
