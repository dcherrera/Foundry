# TeamIDE: only what its PM reads from git is tracked -- project.yml and the
# tasks/plans/notes/agents markdown (TeamIDE reads the kanban via `git ls-tree`,
# so a blanket .teamide/ rule would hide it). Everything else under .teamide/ is
# machine- or session-specific: subrepos.json (per-user clone URLs), chat
# history, activity log, agent runs and reports, caches.
.teamide/*
!.teamide/project.yml
!.teamide/tasks/
!.teamide/plans/
!.teamide/notes/
!.teamide/agents/

